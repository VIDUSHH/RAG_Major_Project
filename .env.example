# General Configuration
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Django Control Plane
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-1234567890
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_PORT=8000

# PostgreSQL Database
POSTGRES_DB=postmortem_db
POSTGRES_USER=postmortem_user
POSTGRES_PASSWORD=postmortem_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# FastAPI Data Plane
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
FASTAPI_SECRET_KEY=fastapi-insecure-change-this-in-production-key-0987654321
FASTAPI_INTERNAL_API_KEY=internal-api-secret-key-change-me

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Neo4j Graph Database
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=postmortem_neo4j_pass

# AI / LLM Configuration
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-1.5-flash

# Internal Communications
FASTAPI_INTERNAL_URL=http://localhost:8001
DJANGO_INTERNAL_URL=http://localhost:8000
