# General Configuration
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Django Control Plane
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-1234567890
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
# Comma-separated list of allowed CORS origins (leave blank to allow all in DEBUG mode)
CORS_ALLOWED_ORIGINS=

# PostgreSQL Database
POSTGRES_DB=RAG_Project
POSTGRES_USER=postmortem_user
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# FastAPI Data Plane
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
FASTAPI_SECRET_KEY=FASTAPI_SECRET_KEY
FASTAPI_INTERNAL_API_KEY=FASTAPI_INTERNAL_API_KEY

# Qdrant Vector Store
# For Qdrant Cloud: set QDRANT_URL (host/port ignored when URL is set)
QDRANT_URL=QDRANT_URL
QDRANT_API_KEY=QDRANT_API_KEY

# Local Qdrant fallback (used only when QDRANT_URL is not set)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Neo4j Graph Database
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=NEO4J_PASSWORD

# AI / LLM Configuration
GEMINI_API_KEY=GEMINI_API_KEY
# Embeddings: local by default (no API quota). EMBEDDING_PROVIDER=gemini +
# EMBEDDING_MODEL=gemini-embedding-2 to use the Gemini API instead.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.1
# Optional cross-encoder reranking on top of RRF fusion (off by default; downloads a model on first query)
RERANKING_ENABLED=False

# Ingestion guardrails
# Caps how many chunks a single file may produce. Prevents a huge file from
# exhausting the daily embedding quota (gemini-embedding-2 free tier is 1000 req/day).
MAX_CHUNKS_PER_FILE=5000

# Internal Communications
FASTAPI_INTERNAL_URL=http://localhost:8001
DJANGO_INTERNAL_URL=http://localhost:8000